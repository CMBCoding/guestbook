<!DOCTYPE html>
<html lang="en">
<%- include('partials/head.ejs') %>
<title>Guestbook - Home</title>
<body>
    <main id="main">
        <form action="/confirm" method="post" id="guestbook-form">
            <h1>Guestbook</h1>
            <fieldset>
                <legend>Please enter your information</legend>

                <!-- First Name field -->
                <div class="form-sect">
                    <label for="fname">First name:</label>
                    <input type="text" id="fname" name="fname" placeholder="John">
                    <span class="error-msg" id="error-msg-fname">Please enter your first name:</span>
                </div>

                <!-- Last Name field -->
                <div class="form-sect">
                    <label for="lname">Last name:</label>
                    <input type="text" id="lname" name="lname" placeholder="Doe">
                    <span class="error-msg" id="error-msg-lname">Please enter your last name</span>
                </div>

                <!-- Phone Number field -->
                <div class="form-sect">
                    <label for="number">Phone number <em>(format: xxx-xxx-xxxx):</em> </label>
                    <input type="tel" id="number" name="number" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" placeholder="123-456-7890">
                    <span class="error-msg" id="error-msg-number">Please enter your phone number</span>
                </div>

                <!-- Email field -->
                <div class="form-sect">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" placeholder="johndoe@email.com">
                    <span class="error-msg" id="error-msg-email">Please enter your email</span>
                </div>
            </fieldset>

            <fieldset>
                <legend>Please enter the length of your stay</legend>
                
                <div class="form-sect">
                    <!-- Check-in Date field -->
                    <label for="checkinDate">Please enter your check-in date:</label>
                    <input type="date" name="checkinDate" id="checkinDate">
                    <!-- Check-out Date field -->
                    <label for="checkOutDate">Please enter your check-out date:</label>
                    <input type="date" name="checkOutDate" id="checkOutDate">
                    <span class="error-msg" id="error-msg-date">Please the length of your stay</span>
                </div>
            </fieldset>

            <fieldset id="comments-section">
                <legend>Comments</legend>
                <label for="comments">Any comments regarding your stay?</label>
                <textarea name="comments" id="comments"></textarea>
            </fieldset>
            <button type="submit" id="book-btn">Book Now!</button>
        </form>
    </main>
</body>
</html>
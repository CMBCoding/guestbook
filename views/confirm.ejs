<!DOCTYPE html>
<html lang="en">
<%- include('partials/head.ejs') %>
<title>Guestbook - Confirm</title>
<body>
    <%- include('partials/header.ejs') %>
    <main id="main">
            <h1>Booking Confirmed!</h1>
            <div id="confirm-box">
                <h2>Booking Details</h2>
                <ul>
                    <li><strong>Booking posted:</strong> <%= booking.timestamp.toLocaleString() %></li>
                    <li><strong>Name:</strong> <%= booking.fname %> <%= booking.lname %></li>
                    <li><strong>Phone number:</strong> <%= booking.phone %></li>
                    <li><strong>Email:</strong> <%= booking.fname %></li>
                    <li><strong>Check-in date:</strong> <%= booking.checkinDate %></li>
                    <li><strong>Check-out date</strong>: <%= booking.checkOutDate %></li>
                    <li><strong>Comments:</strong> <%= booking.comments %></li>
                
                </ul>
            </div>

    </main>
    <%- include('partials/footer.ejs') %>
</body>
<script>

</script>
</html>